using System;

class Program
{
    static void Main()
    {
        string[] clientes =
        {
         "Joaozinho","Pedrinho","Tharso","Bernini","Cleiosvaldo"
        };

        double[] renda =
        {
            8.0,
            4.0,
            7.0,
            3.0,
            6.0
        };

        double[] score =
        {
            9.0,
            5.0,
            8.0,
            4.0,
            7.0
        };

        double[] comprometimento =
        {
            2.0,
            8.0,
            3.0,
            9.0,
            4.0
        };

        double w1 = 0.5;
        double w2 = 0.4;
        double w3 = -0.3;

        double limiar = 5;

        for (int i = 0; i < clientes.Length; i++)
        {
            double z =
                (renda[i] * w1) +
                (score[i] * w2) +
                (comprometimento[i] * w3);

            int resultado;

            if (z >= limiar)
            {
                resultado = 1;
            }
            else
            {
                resultado = 0;
            }

            Console.WriteLine(
                $"Cliente {clientes[i]} | Pontuação: {z:F2} | Resultado: {resultado}"
            );
        }
    }
}
