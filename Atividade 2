            }
            else
            {
                classe = 0;
                baixaPerformance++;
            }

            Console.WriteLine(
                $"{vendedores[i]} | Pontuação: {z:F2} | Classe: {classe}"
            );
        }

        Console.WriteLine();

        Console.WriteLine(
            $"Alta performance: {altaPerformance}"
        );

        Console.WriteLine(
            $"Não atingiram alta performance: {baixaPerformance}"
        );
    }
}
